@model IEnumerable<NTM_Lab03.Models.Product>

<h4 class="section-title">
    Sản phẩm mới nhất
</h4>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-3">
            <div style="border: 1px solid #ddd; padding: 10px; height: 100%;">

                <img src="@item.Image"
                     alt="@item.Name"
                     style="width: 100%; height: 220px; object-fit: contain;" />

                <div style="margin-top: 10px;">
                    @item.Name
                </div>

                <div>
                    @item.Price.ToString("N0") đ
                </div>

            </div>
        </div>
    }
</div>

@await Component.InvokeAsync("HotProduct")