@model Student
@{
    ViewData["Title"] = "Thêm sinh viên";
    Layout = "~/Views/Shared/MyLayout.cshtml";
}

<h1>Thêm sinh viên</h1>

<form asp-controller="Student" asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>B
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Branch" class="form-label"></label>
        <select asp-for="Branch" asp-items="Html.GetEnumSelectList<Branch>()"
                class="form-select">
            <option value="">-- Chọn ngành học --</option>
        </select>
        <span asp-validation-for="Branch" class="text-danger"></span>
    </div>

    <fieldset class="mb-3">
        <legend class="fs-6">Giới tính</legend>
        @foreach (var item in Html.GetEnumSelectList<Gender>())
        {
            <div class="form-check form-check-inline">
                <input asp-for="Gender" type="radio" value="@item.Value"
                       id="gender_@item.Value" class="form-check-input" />
                <label for="gender_@item.Value" class="form-check-label">
                    @item.Text
                </label>
            </div>
        }
        <span asp-validation-for="Gender" class="text-danger"></span>
    </fieldset>

    <div class="form-check mb-3">
        <input asp-for="IsRegular" class="form-check-input" />
        <label asp-for="IsRegular" class="form-check-label"></label>
    </div>

    <div class="mb-3">
        <label asp-for="DateOfBirth" class="form-label"></label>
        <input asp-for="DateOfBirth" class="form-control"
               min="1963-01-01" max="2005-12-31" />
        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Address" class="form-label"></label>
        <textarea asp-for="Address" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Grade" class="form-label"></label>
        <input asp-for="Grade" type="number" step="any" min="0" max="10"
               data-val-number="Điểm phải là số." class="form-control" />
        <span asp-validation-for="Grade" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Lưu sinh viên</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $.extend($.validator.messages, {
            number: "Vui lòng nhập một số hợp lệ.",
            date: "Vui lòng nhập ngày hợp lệ."
        });
        // jQuery range mặc định dành cho số, không dùng cho DateTime.
        $.validator.addMethod("birthDateRange", function (value, element) {
            return this.optional(element) ||
                (/^\d{4}-\d{2}-\d{2}$/.test(value) &&
                 value >= element.min && value <= element.max);
        }, "Ngày sinh phải từ 01/01/1963 đến 31/12/2005.");
        $(function () {
            var dateInput = $("#DateOfBirth");
            dateInput.rules("remove", "range date");
            dateInput.rules("add", { birthDateRange: true });
        });
    </script>
}