@model IEnumerable<Learner>
@{
    ViewData["Title"] = "Danh sách người học";
    Layout = "~/Views/Shared/MyLayout.cshtml";
}
<h1>Danh sách người học</h1>
<a asp-action="Create" class="btn btn-primary mb-3">Thêm người học</a>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Mã</th><th>Tên</th><th>Họ</th><th>Ngành</th>
            <th>Ngày nhập học</th><th>Chức năng</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.LearnerID</td>
                <td>@s.FirstMidName</td>
                <td>@s.LastName</td>
                <td>@s.Major?.MajorName</td>
                <td>@s.EnrollmentDate.ToString("dd/MM/yyyy")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@s.LearnerID">Sửa</a> |
                    <a asp-action="Delete" asp-route-id="@s.LearnerID">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>