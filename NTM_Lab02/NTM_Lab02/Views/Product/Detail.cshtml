
@using NTM_Lab02.Models

@{
    ViewData["Title"] = "Chi tiết sản phẩm";

    Product product = ViewBag.Product;
}

<h3>Chi tiết sản phẩm</h3>

<div class="row">

    <div class="col-md-4">

        <img src="@Url.Content(product.Image)"
             style="width:100%;" />

    </div>

    <div class="col-md-8">

        <h2>
            Sản phẩm: @product.Name
        </h2>

        <h4>
            Giá gốc:
            <del>@product.Price</del>

            Giá mới:
            @product.SalePrice
        </h4>

        <h4>Mô tả:</h4>

        <p>
            @product.Description
        </p>

        <h4>
            Trạng thái:

            @if (product.Status == 1)
            {
                <span>Còn hàng</span>
            }
            else
            {
                <span>Hết hàng</span>
            }
        </h4>

        <h4>
            Ngày đăng:
            @product.CreatedAt
        </h4>

        <a asp-route="product"
           asp-route-action="Index"
           class="btn btn-danger">
            Về danh sách
        </a>

    </div>

</div>